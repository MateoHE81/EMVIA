# This file documents optional environment variables.
# Node.js does not read it automatically with the default npm start command.

HOST=0.0.0.0
PORT=8080
WS_PATH=/ws

# Leave empty during local prototyping. Set a long random value for deployment.
RELAY_TOKEN=

MAX_PAYLOAD_BYTES=16384
MAX_MESSAGES_PER_SECOND=50
MAX_HOME_CLIENTS_PER_MATCH=500
HEARTBEAT_INTERVAL_MS=30000
CACHE_WINDOW_MS=5000
MAX_CACHED_MESSAGES_PER_MATCH=100
